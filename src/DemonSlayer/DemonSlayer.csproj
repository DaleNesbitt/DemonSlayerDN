<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DemonSlayer</RootNamespace>

    <!-- Enables XML documentation generation so tools (and CI) 
         can automatically produce documentation from your /// comments -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Stops the compiler warning you about every missing XML comment.
         Keeps your CI pipeline clean and avoids hundreds of warnings. -->
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <!-- Add logging packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>


</Project>
